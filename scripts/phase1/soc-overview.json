    {
      "id": 5,
      "type": "stat",
      "title": "Customers Needing Attention",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
