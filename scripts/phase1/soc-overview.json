      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nSELECT\n  v.cve_id AS \"CVE\",\n  v.affected_software AS \"Software\",\n  MAX(v.cvss_score)::numeric(4,1) AS \"CVSS\",\n  COUNT(DISTINCT v.endpoint_id)::int AS \"Endpoints\",\n  COUNT(DISTINCT e.organization_id)::int AS \"Customers\"\nFROM public.vulnerability_findings v\nJOIN public.endpoints e ON e.id = v.endpoint_id\nWHERE v.status = 'open'\n  AND e.organization_id::text IN (${org:singlequote})\nGROUP BY v.cve_id, v.affected_software\nORDER BY MAX(v.cvss_score) DESC NULLS LAST, COUNT(DISTINCT v.endpoint_id) DESC\nLIMIT 25\n",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "CVSS",
            "desc": true
