      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nSELECT COUNT(DISTINCT v.cve_id)::int AS value\nFROM public.vulnerability_findings v\nJOIN public.endpoints e ON e.id = v.endpoint_id\nWHERE v.status = 'open'\n  AND v.cvss_score >= 9.0\n  AND e.organization_id::text IN (${org:singlequote})",
