    {
      "id": 4,
      "type": "stat",
      "title": "RTP Disabled",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "peritus-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nWITH latest AS (\n  SELECT DISTINCT ON (es.endpoint_id) es.endpoint_id, es.realtime_protection_enabled\n  FROM public.endpoint_status es\n  ORDER BY es.endpoint_id, es.collected_at DESC\n)\nSELECT COUNT(*)::int AS value\nFROM latest\nJOIN public.endpoints e ON e.id = latest.endpoint_id\nWHERE latest.realtime_protection_enabled = false\n  AND e.is_active = true\n  AND e.organization_id::text IN (${org:singlequote})",
          "format": "table"
        }
