    {
      "id": 30,
      "type": "table",
      "title": "Endpoint Inventory (sorted by open threats, then most-recent)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "peritus-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nWITH latest_status AS (\n  SELECT DISTINCT ON (endpoint_id) endpoint_id, realtime_protection_enabled, collected_at\n  FROM public.endpoint_status ORDER BY endpoint_id, collected_at DESC\n),\nthreats_per AS (\n  SELECT endpoint_id, COUNT(*) AS active_threats\n  FROM public.endpoint_threats\n  WHERE status='Active' AND COALESCE(manual_resolution_active,false)=false\n  GROUP BY endpoint_id\n)\nSELECT\n  o.name AS \"Customer\",\n  e.hostname AS \"Hostname\",\n  e.os_version AS \"OS\",\n  CASE WHEN e.is_online THEN 'Online' ELSE 'Offline' END AS \"Status\",\n  CASE\n    WHEN e.last_seen_at IS NULL THEN 'Never'\n    WHEN e.last_seen_at > NOW() - INTERVAL '1 hour' THEN ROUND(EXTRACT(EPOCH FROM (NOW()-e.last_seen_at))/60)::text || 'm ago'\n    WHEN e.last_seen_at > NOW() - INTERVAL '1 day' THEN ROUND(EXTRACT(EPOCH FROM (NOW()-e.last_seen_at))/3600)::text || 'h ago'\n    ELSE ROUND(EXTRACT(EPOCH FROM (NOW()-e.last_seen_at))/86400)::text || 'd ago'\n  END AS \"Last Seen\",\n  CASE WHEN ls.realtime_protection_enabled IS TRUE THEN 'On'\n       WHEN ls.realtime_protection_enabled IS FALSE THEN 'Off'\n       ELSE '?' END AS \"RTP\",\n  COALESCE(e.defender_version, '\u2014') AS \"Defender\",\n  COALESCE(e.agent_version, '\u2014') AS \"Agent\",\n  COALESCE(tp.active_threats, 0)::int AS \"Threats\"\nFROM public.endpoints e\nJOIN public.organizations o ON o.id = e.organization_id\nLEFT JOIN latest_status ls ON ls.endpoint_id = e.id\nLEFT JOIN threats_per tp ON tp.endpoint_id = e.id\nWHERE e.is_active = true\n  AND e.organization_id::text IN (${org:singlequote})\nORDER BY tp.active_threats DESC NULLS LAST, e.last_seen_at DESC NULLS LAST\n",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Threats",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Online": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "Offline": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RTP"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "On": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "Off": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "?": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Threats"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
