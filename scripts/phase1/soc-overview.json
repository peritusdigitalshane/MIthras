      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nWITH risk AS (\n  SELECT o.id, o.name,\n    (SELECT COUNT(*) FROM public.endpoint_threats t JOIN public.endpoints e ON e.id=t.endpoint_id\n       WHERE e.organization_id=o.id AND t.status='Active' AND COALESCE(t.manual_resolution_active,false)=false AND t.severity IN ('Severe','High')) AS hi_threats,\n    (SELECT COUNT(DISTINCT v.cve_id) FROM public.vulnerability_findings v JOIN public.endpoints e ON e.id=v.endpoint_id\n       WHERE e.organization_id=o.id AND v.status='open' AND v.cvss_score>=9.0) AS crit_cves,\n    (SELECT COUNT(*) FROM public.endpoints e WHERE e.organization_id=o.id AND e.is_active=true\n       AND (e.last_seen_at IS NULL OR e.last_seen_at < NOW() - INTERVAL '24 hours')) AS offline_24h\n  FROM public.organizations o\n  WHERE o.id::text IN (${org:singlequote})\n)\nSELECT COUNT(*)::int AS value FROM risk WHERE hi_threats > 0 OR crit_cves > 0 OR offline_24h > 0\n",
          "format": "table"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
