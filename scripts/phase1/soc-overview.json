          "rawSql": "\nSELECT COUNT(*)::int AS value\nFROM public.endpoints e\nWHERE e.is_active = true\n  AND (e.last_seen_at IS NULL OR e.last_seen_at < NOW() - INTERVAL '24 hours')\n  AND e.organization_id::text IN (${org:singlequote})",
