      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "peritus-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "peritus-db"
          },
          "rawSql": "\nSELECT COUNT(*)::int AS value\nFROM public.endpoint_threats t\nJOIN public.endpoints e ON e.id = t.endpoint_id\nWHERE t.status = 'Active'\n  AND COALESCE(t.manual_resolution_active, false) = false\n  AND t.severity IN ('Severe','High')\n  AND e.organization_id::text IN (${org:singlequote})",
          "format": "table"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
