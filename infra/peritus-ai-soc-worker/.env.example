# Copy to .env on the host (alongside docker-compose.yml) before running.
# Values inside the supabase docker network: SUPABASE_URL points at kong
# because the supabase-js client expects the gateway, not the raw rest port.

SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=<paste service role JWT from /opt/peritus-supabase/.env>
AI_SOC_POLL_SECRET=<paste from platform_settings.ai_soc_poll_secret>

# Optional overrides (defaults shown).
# ORCH_URL=http://supabase-edge-functions:9000/functions/v1/ai-soc-orchestrate
# POLL_INTERVAL_MS=15000
# MAX_PER_CYCLE=3
# ORCH_TIMEOUT_MS=180000
# ALERT_LOOKBACK_MIN=60
